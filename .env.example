# ─── BHASHINI / Udyat OCR API Credentials ───────────────────────────────────
# Get these from https://bhashini.gov.in → My Profile → API Keys
#
# BHASHINI_UDYAT_API_KEY: Your ULCA API key (ulcaApiKey)
# BHASHINI_USER_ID: Your registered user ID on the BHASHINI platform
# BHASHINI_INFERENCE_KEY: Your inference/authorization key for Dhruva API
#
# ⚠️  NEVER commit this file with real credentials to version control.
#     Copy this file to .env and fill in your actual values.
# ─────────────────────────────────────────────────────────────────────────────

BHASHINI_UDYAT_API_KEY=your_ulca_api_key_here
BHASHINI_USER_ID=your_user_id_here
BHASHINI_INFERENCE_KEY=your_inference_authorization_key_here
